{
  "name": "sona",
  "private": true,
  "version": "1.11.0",
  "type": "module",
  "description": "Sona - A League of Legends client plugin for Pengu Loader",
  "license": "AGPL-3.0",
  "config": {
    "pluginName": "sona",
    "loaderPath": "../../"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "build:bundle": "vite build",
    "build:install": "npm run typecheck && vite build --mode install",
    "preview": "vite preview",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "vite-plugin-mkcert": "^1.17.8",
    "vitest": "^3.2.7"
  }
}
